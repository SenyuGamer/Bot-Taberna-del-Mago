# Token del bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=pega_aqui_tu_token

# ID de la aplicación (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=pega_aqui_tu_client_id

# (Opcional) ID de tu servidor de pruebas para registrar los comandos al instante.
# Si lo dejas vacío, "bun run deploy" registrará los comandos globalmente (tardan hasta 1 hora).
GUILD_ID=

# (Opcional) Ruta de la base de datos SQLite
# DB_PATH=data/taberna.sqlite

# ---------- Integración con Twitch (opcional; detecta canjes de inspiración) ----------
# Crea una app en https://dev.twitch.tv/console/apps (puedes reutilizar la de OwlTwitch)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# NO hace falta rellenarlas a mano: se generan con el comando /sincronizar twitch en Discord
# (o con "npm run twitch-auth" desde la terminal)
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# (Opcional) Regex para reconocer el canje. Por defecto: cualquier título que diga "inspiraci..."
# TWITCH_REWARD_REGEX=inspiraci

# URL PÚBLICA del callback OAuth (aque registres en tu app de Twitch).
# Si el bot corre en un servidor/headless, usa un túnel (Cloudflare, etc.) que
# reenvíe a localhost:TWITCH_AUTH_PORT. Si la dejas vacía, se usa
# http://localhost:TWITCH_AUTH_PORT/callback (solo sirve en la misma máquina).
# TWITCH_CALLBACK_URL=https://tu-tunel.example.com/callback

# Puerto local donde escucha el servidor temporal de autenticación.
# Debe coincidir con el destino del túnel (si usas uno).
# TWITCH_AUTH_PORT=3050
